from pprint import pprint  # For nice printing

def organize_hurricanes_by_year(hurricanes):
    """
    Convert hurricanes dictionary (keyed by name) to a dictionary keyed by year.
    Each year contains a list of hurricane dictionaries that occurred in that year.
    """
    hurricanes_by_year = {}  # New dictionary keyed by year
    
    # Step 1: Loop through each hurricane in the original dictionary
    for hurricane_name, hurricane_info in hurricanes.items():
        current_year = hurricane_info["Year"]  # Get the year of this hurricane
        current_cane = hurricane_info          # The full hurricane dictionary
        
        print(f"\nProcessing hurricane: {hurricane_name} ({current_year})")  # Step-by-step print
        
        # Step 2: Check if the year already exists in the new dictionary
        if current_year not in hurricanes_by_year:
            # If the year is not yet a key, create a new list with this hurricane
            hurricanes_by_year[current_year] = [current_cane]
            print(f"  Year {current_year} not found, initializing list with this hurricane.")
        else:
            # If the year exists, append this hurricane to the list
            hurricanes_by_year[current_year].append(current_cane)
            print(f"  Year {current_year} already exists, appending this hurricane.")
    
    return hurricanes_by_year

# Example usage
