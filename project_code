from pprint import pprint

# Mortality scale
mortality_scale = {
    0: 0,
    1: 100,
    2: 500,
    3: 1000,
    4: 10000
}

def rate_hurricanes_by_mortality(hurricanes, scale):
    """
    Rate hurricanes based on deaths using the mortality_scale.
    Returns a dictionary where keys are mortality ratings and values are lists of hurricanes.
    """
    # Step 1: Create dictionary to store hurricanes by rating
    rated_hurricanes = {rating: [] for rating in scale}
    rated_hurricanes[5] = []  # Rating 5 is for deaths > 10000
    
    # Step 2: Loop through each hurricane
    for hurricane_name, hurricane_info in hurricanes.items():
        deaths = hurricane_info["Deaths"]
        print(f"\nProcessing hurricane: {hurricane_name} with {deaths} deaths")
        
        # Step 3: Determine rating
        rating_assigned = None
        for rating, upper_bound in scale.items():
            if deaths > upper_bound and deaths <= scale.get(rating + 1, float('inf')):
                rating_assigned = rating + 1
                break
        
        # Step 4: Add hurricane to the appropriate rating list
        rated_hurricanes[rating_assigned].append(hurricane_info)
        print(f"  Assigned to mortality rating: {rating_assigned}")
    
    return rated_hurricanes

# Test the function
hurricanes_by_mortality = rate_hurricanes_by_mortality(hurricane_data, mortality_scale)

# Pretty print the results
